<%- include('partials/head', { title, bodyClass: 'white' }) %>
<%
  const job = ad.kind === 'job';
  const storeName = ad.store_name || ad.business_name;
  const head = [dongOf(ad.dong, ad.address), storeName].filter(Boolean).join(' ');
  const tel = ad.phone.replace(/[^0-9]/g, '');
  // 지도 검색은 상세 주소(층·호수)를 빼고 기본 주소까지만
  const mapQuery = String(ad.address || '').replace(/\s*\(.*$/, '').trim() || ad.address;
%>
<header class="bar">
  <a href="<%= isOwner && ad.status !== 'approved' ? '/ads/mine' : '/ads' %>" class="icon-btn" aria-label="뒤로">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
  </a>
  <span class="bar-title"><%= job ? '구인광고' : '광고' %></span>
  <% if (isOwner && ['pending', 'approved', 'suspended', 'rejected'].includes(ad.status)) { %>
    <a href="/ads/<%= ad.id %>/edit" class="icon-btn" aria-label="광고 수정" title="수정">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
    </a>
  <% } else { %>
    <span class="icon-btn" aria-hidden="true"></span>
  <% } %>
</header>

<main class="ad-detail has-call-bar">
  <% if (ad.status !== 'approved') { %>
    <p class="notice warn">공개되지 않은 광고예요. 등록한 분과 운영자만 볼 수 있어요.</p>
  <% } %>
  <img class="ad-cover ad-hero<%= coverSet ? '' : ' is-default' %>" src="<%= coverUrl %>" alt="<%= coverSet ? storeName + ' 대표 이미지' : '' %>">
  <div class="ad-meta">
    <% if (job) { %><span class="kind-badge job">구인</span><% } %>
    <span class="tag"><%= cat.name %></span>
    <% if (ad.has_license) { %><span class="ad-verified">허가증 확인</span><% } %>
    <span class="ad-views" aria-label="조회 <%= ad.view_count %>회"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><%= Number(ad.view_count).toLocaleString('ko-KR') %></span>
  </div>
  <% if (ad.store_hours) { %><p class="ad-hours ad-hours-lg">🕒 영업시간 <%= ad.store_hours %></p><% } %>
  <h1><% if (head) { %><span class="ad-dong">[<%= head %>]</span> <% } %><%= ad.title %></h1>

  <%# 전화하기: 화면 아래(하단 바 위)에 고정 %>
  <div class="ad-call-bar">
    <a href="tel:<%= tel %>" class="btn-call">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      전화하기
    </a>
  </div>

  <% if (job) { %>
  <dl class="ad-info job-summary">
    <% if (ad.employment_type) { %><div><dt>고용형태</dt><dd><%= empTypes[ad.employment_type] %></dd></div><% } %>
    <div><dt>급여</dt><dd class="job-pay"><%= payText %></dd></div>
    <% if (ad.job_role) { %><div><dt>모집 직무</dt><dd><%= ad.job_role %></dd></div><% } %>
    <% if (ad.work_hours) { %><div><dt>근무 시간</dt><dd><%= ad.work_hours %></dd></div><% } %>
    <div><dt>지원 자격</dt><dd>만 19세 이상</dd></div>
  </dl>
  <% } %>

  <%# bodyHtml 은 services/richtext 로 허용한 태그만 남긴 HTML %>
  <h2 class="ad-section">상세정보</h2>
  <div class="rich-body"><%- bodyHtml %></div>

  <h2 class="ad-section">업체 정보</h2>
  <dl class="ad-info">
    <div><dt>🏪 업체명</dt><dd><%= storeName %></dd></div>
    <% if (ad.contact_name) { %><div><dt>👤 담당자</dt><dd><%= ad.contact_name %></dd></div><% } %>
    <div><dt>📞 연락처</dt><dd><a href="tel:<%= tel %>"><%= ad.phone %></a></dd></div>
    <% if (ad.kakao_id) { %><div><dt>💬 카카오톡</dt><dd><%= ad.kakao_id %></dd></div><% } %>
    <% if (ad.line_id) { %><div><dt>💚 라인</dt><dd><%= ad.line_id %></dd></div><% } %>
    <% if (ad.wechat_id) { %><div><dt>🟢 위챗</dt><dd><%= ad.wechat_id %></dd></div><% } %>
    <% if (ad.telegram_id) { %><div><dt>✈️ 텔레그램</dt><dd><%= ad.telegram_id %></dd></div><% } %>
    <% if (ad.link_url) { %>
      <div><dt>🔗 링크</dt><dd><a href="<%= ad.link_url %>" target="_blank" rel="noopener noreferrer nofollow sponsored"><%= ad.link_url.replace(/^https?:\/\//, '') %></a></dd></div>
    <% } %>
  </dl>

  <% if (ad.address) { %>
  <h2 class="ad-section">위치정보</h2>
  <div class="ad-location">
    <% if (kakaoKey) { %>
      <%# 카카오맵: 주소(층·호수 뺀 기본 주소)를 좌표로 바꿔 핀 하나 (public/js/ad-map.js) %>
      <div class="ad-map" data-ad-map data-address="<%= mapQuery %>" role="region" aria-label="<%= storeName %> 위치 지도">
        <p class="ad-map-status" data-ad-map-status>지도를 불러오는 중이에요.</p>
      </div>
    <% } %>
    <p class="ad-location-addr"><%= ad.address %></p>
  </div>
  <% } %>

  <h2 class="ad-section">사업자 정보</h2>
  <dl class="ad-info ad-info-sm">
    <div><dt>상호</dt><dd><%= ad.business_name %></dd></div>
    <div><dt>사업자번호</dt><dd><%= ad.b_no.slice(0, 3) %>-<%= ad.b_no.slice(3, 5) %>-<%= ad.b_no.slice(5) %></dd></div>
  </dl>

  <p class="fine">강남의숲은 광고 내용을 보증하지 않아요. 문제가 있는 광고는 운영자에게 알려주세요.</p>
</main>
<% if (ad.address && kakaoKey) { %>
<script src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=<%= encodeURIComponent(kakaoKey) %>&libraries=services&autoload=false" defer></script>
<script src="/js/ad-map.js" defer></script>
<% } %>
<%- include('partials/foot') %>
