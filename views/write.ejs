<%- include('partials/head', { title, bodyClass: 'white' }) %>
<form method="post" action="/write" class="write-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <header class="bar">
    <a href="/forest" class="bar-link">취소</a>
    <span class="bar-title">글쓰기</span>
    <button type="submit" class="btn-pill">올리기</button>
  </header>

  <main class="write-wrap">
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

    <fieldset class="board-pick">
      <legend>게시판</legend>
      <div class="chips wrap">
        <% boards.forEach(function (b) { %>
          <label class="chip-radio">
            <input type="radio" name="board" value="<%= b %>" <%= form.board === b ? 'checked' : '' %>>
            <span><%= b %></span>
          </label>
        <% }) %>
      </div>
      <% const gb = boards.filter(function (b) { return b === '여성의숲' || b === '남성의숲'; }); %>
      <% if (gb.length) { %><p class="hint board-hint"><%= gb.join(', ') %>에 쓴 글은 같은 성별 회원에게만 보여요.</p><% } %>
    </fieldset>

    <div class="fields">
      <label for="title" class="sr-only">제목</label>
      <input id="title" name="title" type="text" maxlength="100" placeholder="제목" value="<%= form.title %>" required>
      <label for="body" class="sr-only">내용</label>
      <textarea id="body" name="body" maxlength="5000" placeholder="오늘 있었던 일, 후기, 썰, 궁금한 점을 편하게 적어주세요." required><%= form.body %></textarea>
    </div>

    <div class="rules-box">
      <div class="rules-head">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="M12 8v5M12 16.5v.01"/></svg>
        <strong>올리기 전에 확인해주세요</strong>
      </div>
      <ul>
        <li>실명, 가게 이름, 별명처럼 특정인을 알아볼 수 있는 내용이 있으면 삭제돼요.</li>
        <li>다른 사람의 사생활 폭로나 범죄 의혹 글은 삭제되고 이용이 제한될 수 있어요.</li>
        <li>광고, 홍보, 연락처가 들어간 글은 올릴 수 없어요.</li>
      </ul>
    </div>
  </main>
</form>
<%- include('partials/foot') %>
