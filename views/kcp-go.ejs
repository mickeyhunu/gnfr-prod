<%- include('partials/head', { title, bodyClass: 'start' }) %>
<main class="auth-page auth-center">
  <img class="auth-mark" src="/images/brand/logo.webp" width="1199" height="1312" alt="">
  <h1>휴대폰 본인확인</h1>
  <p class="auth-lead">본인확인 화면으로 이동하고 있어요.<br>넘어가지 않으면 아래 버튼을 눌러주세요.</p>
  <form class="auth-form" method="post" action="<%= callUrl %>" data-kcp-auto>
    <input type="hidden" name="reg_cert_key" value="<%= regCertKey %>">
    <input type="hidden" name="kcp_page_submit_yn" value="Y">
    <button type="submit" class="btn-primary">본인확인 계속하기</button>
  </form>
</main>
<script src="/js/kcp-go.js" defer></script>
<%- include('partials/foot') %>
