<% if (p.locked) { %><div class="card locked" aria-disabled="true"><% } else { %><a href="/p/<%= p.id %>" class="card<%= p.is_read ? ' read' : '' %>"><% } %>
  <% if (locals.rank) { %><span class="rank"><%= rank %></span><% } %>
  <div class="card-body">
    <div class="meta">
      <span class="tag"><%= p.board %></span>
      <% if (h.isHot(p)) { %>
        <span class="tag hot"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c1 4 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5 0 2 1 3 2 3 0-3-1-5 1-8.5z"/></svg>핫</span>
      <% } %>
      <% if (p.status === 'pending') { %><span class="tag warn">검토 중</span><% } %>
      <% if (p.status === 'hidden') { %><span class="tag muted">숨김</span><% } %>
      <span><%= h.timeAgo(p.created_at) %></span>
    </div>
    <strong class="card-title"><% if (h.isNew(p)) { %><span class="new-badge" title="새 글">N</span><% } %><span class="title-text"><% if (p.locked) { %><svg class="lock-mini" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><% } %><%= p.title %></span><span class="title-cmt<%= p.comment_count > 0 ? '' : ' zero' %>" title="댓글 <%= p.comment_count %>개"><span class="sr-only">댓글</span>[<%= p.comment_count %>]</span></strong>
    <% if (p.preview) { %><span class="preview"><%= p.preview %></span><% } %>
    <div class="stats">
      <span class="up" title="추천"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg><span class="sr-only">추천</span><%= p.up_count %></span>
      <span class="down" title="반대"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg><span class="sr-only">반대</span><%= p.down_count || 0 %></span>
      <span title="조회"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><span class="sr-only">조회</span><%= p.view_count || 0 %></span>
    </div>
  </div>
<%- p.locked ? '</div>' : '</a>' %>
