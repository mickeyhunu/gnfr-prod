<%- include('partials/head', { title }) %>
<%
  // 종류별 아이콘 (stroke 아이콘)
  const ICONS = {
    comment: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    reply: '<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>',
    inquiry: '<path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12h5"/>',
    ad: '<path d="M3 11v2a1 1 0 0 0 1 1h3l5 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M16 9a4 4 0 0 1 0 6"/>',
  };
  const AD_TEXT = { approved: '게시됐어요', rejected: '반려됐어요', suspended: '게시가 중단됐어요' };
%>
<% const canReadAll = type ? unread[type] : unreadAll; %>
<header class="top">
  <div class="top-row">
    <nav class="chips" aria-label="알림 종류">
      <a href="/notifications" class="chip<%= !type ? ' on' : '' %>" <%- !type ? 'aria-current="page"' : '' %>>전체<% if (unreadAll) { %> <span class="chip-badge"><%= unreadAll %></span><% } %></a>
      <% Object.keys(types).forEach(function (k) { %>
        <a href="/notifications?type=<%= k %>" class="chip<%= type === k ? ' on' : '' %>" <%- type === k ? 'aria-current="page"' : '' %>><%= types[k] %><% if (unread[k]) { %> <span class="chip-badge"><%= unread[k] %></span><% } %></a>
      <% }) %>
    </nav>
    <form method="post" action="/notifications/read-all" class="view-pick-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
      <button type="submit" class="view-pick view-pick-text" aria-label="<%= type ? types[type] + ' 알림 ' : '' %>모두 읽음" <%= canReadAll ? '' : 'disabled' %>>모두 읽음</button>
    </form>
  </div>
</header>

<main class="list">
  <% if (done) { %><p class="notice" role="status">알림을 모두 읽음으로 바꿨어요.</p><% } %>

  <% if (!items.length) { %>
    <p class="empty"><% if (type) { %><%= types[type] %> 알림이 없어요.<% } else { %>아직 알림이 없어요.<br>내 글에 댓글·답글이 달리거나, 문의 답변·광고 심사 결과가 나오면 알려드려요.<% } %></p>
  <% } %>
  <ul class="notif-list">
    <% items.forEach(function (n) { const unreadOne = !n.read_at; %>
      <li>
        <a href="/notifications/<%= n.id %>" class="notif notif-<%= n.type %><%= n.type === 'ad' ? ' ad-' + n.event : '' %><%= unreadOne ? ' unread' : '' %>">
          <span class="notif-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- ICONS[n.type] || ICONS.comment %></svg>
          </span>
          <span class="notif-text">
            <span class="notif-type"><%= types[n.type] || '알림' %></span>
            <% if (n.type === 'comment') { %>
              <span><b><%= h.anonName(n.anon_no) %></b>님이 내 글 <b>「<%= n.post_title %>」</b>에 댓글을 남겼어요.</span>
              <span class="notif-body"><%= n.body %></span>
            <% } else if (n.type === 'reply') { %>
              <span><b><%= h.anonName(n.anon_no) %></b>님이 「<%= n.post_title %>」의 내 댓글에 답글을 남겼어요.</span>
              <span class="notif-body"><%= n.body %></span>
            <% } else if (n.type === 'inquiry') { %>
              <span>문의 <b>「<%= n.inquiry_title || '삭제된 문의' %>」</b>에 답변이 달렸어요.</span>
            <% } else if (n.type === 'ad') { %>
              <span><b>「<%= n.ad_title || n.business_name || '내 광고' %>」</b> 광고가 <%= AD_TEXT[n.event] || '바뀌었어요' %>.</span>
              <% if (n.note) { %><span class="notif-body">사유: <%= n.note %></span><% } %>
            <% } %>
            <span class="notif-time"><%= h.timeAgo(n.created_at) %><% if (unreadOne) { %> · <em>새 알림</em><% } %></span>
          </span>
        </a>
      </li>
    <% }) %>
  </ul>
</main>
<%- include('partials/foot') %>
