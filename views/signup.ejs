<%- include('partials/head', { title, bodyClass: 'start' }) %>
<main class="auth-page auth-center">
  <img class="auth-mark" src="/images/brand/logo.webp" width="1199" height="1312" alt="">
  <h1>회원가입</h1>
  <p class="auth-lead">아이디 없이 휴대폰 번호와 비밀번호로 로그인해요.<br>번호는 글과 댓글에 표시되지 않아요.</p>

  <% if (kcpOn && !verified) { %>
    <%# 1단계: 휴대폰 본인확인 (만 19세 이상 확인 + 중복 가입 확인) %>
    <div class="auth-form">
      <a class="btn-primary kcp-btn" href="/kcp/start?purpose=signup" data-kcp-popup>휴대폰 본인확인</a>
      <p class="hint">본인 명의 휴대폰으로 만 19세 이상인지 확인해요. 이름·생년월일 등은 어떤 화면에도 표시되지 않아요.</p>
      <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    </div>
  <% } else { %>

  <form class="auth-form" method="post" action="/auth/signup" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (verified) { %>
      <div class="kcp-done" role="status">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        <span><strong><%= verified.name %></strong> 님 본인확인 완료 · <%= verified.phone %></span>
      </div>
      <p class="hint">이 번호가 로그인할 때 쓰는 번호예요.</p>
    <% } else { %>
    <div class="row">
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="휴대폰 번호" aria-label="휴대폰 번호" value="<%= form.phone %>" required>
      <% if (!skipPhoneAuth) { %><button type="button" class="btn-outline" id="send-code">인증번호 받기</button><% } %>
    </div>
    <% } %>
    <% if (verified) { %>
    <% } else if (skipPhoneAuth) { %>
      <p class="hint">지금은 임시로 문자 인증 없이 가입할 수 있어요.</p>
    <% } else { %>
      <p class="hint" id="send-msg" role="status" aria-live="polite"></p>
      <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="인증번호 6자리" aria-label="인증번호" required>
    <% } %>

    <input name="password" type="password" autocomplete="new-password" maxlength="64" placeholder="비밀번호 (영문, 숫자 포함 8자 이상)" aria-label="비밀번호" required>
    <input name="password2" type="password" autocomplete="new-password" maxlength="64" placeholder="비밀번호 확인" aria-label="비밀번호 확인" required>
    <input name="referral" maxlength="20" autocomplete="off" autocapitalize="characters" placeholder="추천인 코드" aria-label="추천인 코드" value="<%= form.referral %>" required>
    <% if (form.invited && form.referral) { %><p class="hint invite-hint">초대 링크로 들어와서 추천인 코드가 입력돼 있어요.</p><% } %>

    <div class="agree-box">
      <label class="check">
        <input type="checkbox" name="adult" value="yes" required>
        <span><em>(필수)</em> 만 19세 이상이며, <a href="/rules">운영 규칙</a>에 동의합니다.</span>
      </label>
      <label class="check">
        <input type="checkbox" name="privacy" value="yes" required>
        <span><em>(필수)</em> 개인정보 수집·이용에 동의합니다.</span>
      </label>
      <details class="agree-detail">
        <summary>개인정보 수집·이용 내용 보기</summary>
        <dl>
          <dt>수집 항목</dt>
          <dd>휴대폰 번호, 비밀번호(암호화하여 저장), 본인인증 정보(이름, 생년월일, 성별, 내·외국인 여부, 통신사, 중복가입 확인정보 CI·DI), 서비스 이용 기록(접속 IP, 접속 일시)</dd>
          <dt>수집·이용 목적</dt>
          <dd>회원 가입과 로그인, 본인 및 만 19세 이상 여부 확인, 중복 가입과 부정 이용 방지, 신고 처리, 법령에 따른 요청 대응</dd>
          <dt>보유·이용 기간</dt>
          <dd>회원 탈퇴 시까지. 다만 관계 법령에서 보관을 정한 경우 그 기간 동안 보관합니다.</dd>
          <dt>동의를 거부할 권리</dt>
          <dd>동의를 거부할 수 있으나, 거부하면 회원 가입을 할 수 없습니다.</dd>
        </dl>
        <p>이름, 생년월일, 성별 등은 글과 댓글을 포함한 어떤 화면에도 표시되지 않습니다.</p>
      </details>
    </div>

    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

    <button type="submit" class="btn-primary">가입하기</button>
  </form>
  <% } %>

  <p class="auth-switch">이미 회원이신가요? <a href="/login">로그인</a></p>
</main>
<%- include('partials/foot') %>
