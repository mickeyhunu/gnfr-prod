<%- include('partials/head', { title, bodyClass: 'start' }) %>
<main class="auth-page auth-center">
  <img class="auth-mark" src="/images/brand/logo.webp" width="1199" height="1312" alt="">
  <h1>비밀번호 찾기</h1>
  <p class="auth-lead">가입한 휴대폰 번호로 본인인증을 하면<br>새 비밀번호를 정할 수 있어요.</p>

  <% if (kcpOn) { %>
    <% if (!verified) { %>
      <div class="auth-form">
        <a class="btn-primary kcp-btn" href="/kcp/start?purpose=reset" data-kcp-popup>휴대폰 본인확인</a>
        <p class="hint">가입할 때 본인확인한 명의의 휴대폰으로 확인해주세요.</p>
        <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
      </div>
    <% } else { %>
      <form class="auth-form" method="post" action="/auth/reset" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="kcp-done" role="status">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>본인확인 완료 · 가입한 번호 <%= verified.phone %></span>
        </div>
        <input name="password" type="password" autocomplete="new-password" maxlength="64" placeholder="새 비밀번호 (영문, 숫자 포함 8자 이상)" aria-label="새 비밀번호" required>
        <input name="password2" type="password" autocomplete="new-password" maxlength="64" placeholder="새 비밀번호 확인" aria-label="새 비밀번호 확인" required>
        <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
        <button type="submit" class="btn-primary">비밀번호 바꾸기</button>
      </form>
    <% } %>
  <% } else if (skipPhoneAuth) { %>
    <p class="error">지금은 문자 인증이 꺼져 있어서 비밀번호를 찾을 수 없어요. 운영자에게 문의해주세요.</p>
  <% } else { %>
  <form class="auth-form" method="post" action="/auth/reset" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="휴대폰 번호" aria-label="휴대폰 번호" value="<%= phone %>" required>
      <button type="button" class="btn-outline" id="send-code">인증번호 받기</button>
    </div>
    <p class="hint" id="send-msg" role="status" aria-live="polite"></p>
    <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="인증번호 6자리" aria-label="인증번호" required>
    <input name="password" type="password" autocomplete="new-password" maxlength="64" placeholder="새 비밀번호 (영문, 숫자 포함 8자 이상)" aria-label="새 비밀번호" required>
    <input name="password2" type="password" autocomplete="new-password" maxlength="64" placeholder="새 비밀번호 확인" aria-label="새 비밀번호 확인" required>

    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>

    <button type="submit" class="btn-primary">비밀번호 바꾸기</button>
  </form>
  <% } %>

  <p class="auth-switch"><a href="/login">로그인으로 돌아가기</a></p>
</main>
<%- include('partials/foot') %>
