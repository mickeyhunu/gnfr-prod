# MySQL: 운영은 AWS RDS. 내 컴퓨터에서는 .env.local 의 DB_ 값(로컬 MySQL)이 우선
#   DB_HOST 에 RDS 엔드포인트(xxxx.xxxx.ap-northeast-2.rds.amazonaws.com)를 적음
#   DB_SSL: RDS 주소면 비워둬도 자동으로 켜짐 (RDS 인증서로 TLS 접속)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gangnam_forest
DB_SSL=

# 이미지 저장소 (AWS S3 공개 버킷). 올린 이미지는 webp 로 바꿔 ad-images/ 에 저장하고 S3 주소로 보여줌
#   운영: gnfr-public-prod / 내 컴퓨터: .env.local 에 같은 이름으로 gnfr-public-dev 를 적으면 그 값이 우선
#   S3_BUCKET_NAME 을 비우면 서버 디스크(uploads/ad-images)에 저장
#   S3_PUBLIC_BASE_URL 을 비우면 https://<버킷>.s3.<리전>.amazonaws.com (CloudFront 를 붙이면 그 주소)
#   EC2 에 IAM 역할을 붙였으면 접근 키는 비워둠
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=gnfr-public-prod
S3_PUBLIC_BASE_URL=
S3_AUTO_CREATE_BUCKET=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
